# autopost-gateway: plain HTTP behind the LMS Caddy, which terminates HTTPS for the Autopost
# domains (edge.caddy → /opt/caddy-sites/autopost.caddy) and forwards here. Routes by Host.
{
	auto_https off
	admin off
	servers {
		# Keep X-Forwarded-Proto: https etc. from the LMS Caddy (Docker networks only).
		trusted_proxies static private_ranges
	}
}

# Static admin pages. Same URLs as vercel.json (cleanUrls): /admin-pages → admin-pages.html
http://{$APP_DOMAIN} {
	root * /srv/web
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
}

# Supabase API for the browser and n8n. Studio stays on its own domain.
http://{$API_DOMAIN} {
	@api path /auth/v1/* /rest/v1/*
	handle @api {
		reverse_proxy autopost-api-gw:8000
	}
	respond 404
}

# Supabase Studio (database admin), behind the API gateway's dashboard login.
http://{$STUDIO_DOMAIN} {
	reverse_proxy autopost-api-gw:8000
}

http://{$N8N_DOMAIN} {
	reverse_proxy autopost-n8n:5678
}
